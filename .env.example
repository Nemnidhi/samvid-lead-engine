# --- MongoDB Atlas ---
# Connection string from Atlas: Database > Connect > Drivers. Include the DB user's
# password (URL-encode any special characters) and appName if Atlas adds one.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
# Logical database name to use within the cluster.
MONGODB_DB=samvid_lead_engine

# --- Google Cloud: Places API ---
# Used by the enrichment worker to check for a Google Business Profile match.
# Create in Google Cloud Console > APIs & Services > Credentials (Places API must be enabled).
GOOGLE_PLACES_API_KEY=

# --- Meta for Developers: Ad Library API ---
# App access token / app-scoped token with Ad Library read access, used to check
# whether a business is currently running Meta ads.
META_AD_LIBRARY_ACCESS_TOKEN=

# --- Groq (primary LLM for report copy) ---
# console.groq.com > API Keys. Used to generate the personalized report paragraph.
GROQ_API_KEY=

# --- Google AI Studio / Gemini (fallback LLM) ---
# aistudio.google.com > Get API Key. Used only if Groq fails or rate-limits.
GEMINI_API_KEY=

# --- Email sending (provider TBD - Phase 7) ---
# Whichever provider we land on (Resend/Mailgun/Brevo), its API key goes here.
EMAIL_PROVIDER_API_KEY=
# The verified sending address/domain for outreach (e.g. outreach@yourdomain.com).
EMAIL_FROM_ADDRESS=

# --- Dashboard auth (Phase 6) ---
# Simple shared credentials gating the internal dashboard. Not for production-grade
# multi-user auth - just enough to keep the tool off the open internet.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# --- Vercel Blob storage (Phase 5, for storing generated PDFs) ---
# Auto-populated by Vercel when you attach a Blob store to the project; only needed
# locally if you want report generation to work outside of Vercel's environment.
BLOB_READ_WRITE_TOKEN=
